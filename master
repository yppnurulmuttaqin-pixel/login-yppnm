<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - YPP NURUL MUTTAQIN</title>
    <!-- Favicon -->
    <link rel="icon" href="https://lh3.googleusercontent.com/d/1drM76LlU3sdqpwo-Urq7ZULoyORC0UMQ">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background-color: #f4f6f9;
            color: #333;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        /* Header Styling */
        header {
            background-color: #006633; /* Warna Hijau Utama */
            color: white;
            padding: 15px 30px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .header-container {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .brand-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .brand-info img {
            width: 50px;
            height: 50px;
            object-fit: contain;
        }

        .brand-text h1 {
            font-size: 1.1rem;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .brand-text p {
            font-size: 0.85rem;
            opacity: 0.9;
        }

        .btn-beranda {
            color: white;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            padding: 8px 16px;
            border-radius: 6px;
            background-color: rgba(255,255,255,0.15);
            transition: background 0.3s;
        }

        .btn-beranda:hover {
            background-color: rgba(255,255,255,0.25);
        }

        /* Main Section / Login Form */
        main {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 20px;
            flex: 1;
        }

        .login-card {
            background: white;
            width: 100%;
            max-width: 420px;
            padding: 35px 30px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            text-align: center;
        }

        .card-header {
            margin-bottom: 25px;
        }

        .icon-box {
            width: 60px;
            height: 60px;
            background-color: #e6f2ec;
            color: #006633;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px auto;
            font-size: 1.5rem;
        }

        .card-header h2 {
            font-size: 1.4rem;
            color: #1a1a1a;
            margin-bottom: 5px;
        }

        .card-header p {
            font-size: 0.85rem;
            color: #666;
        }

        .form-group {
            text-align: left;
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            font-size: 0.85rem;
            font-weight: 500;
            margin-bottom: 6px;
            color: #444;
        }

        .input-wrapper {
            position: relative;
        }

        .input-wrapper i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #aaa;
            font-size: 0.9rem;
        }

        .input-wrapper input {
            width: 100%;
            padding: 10px 12px 10px 35px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 0.9rem;
            outline: none;
            transition: border-color 0.3s;
        }

        .input-wrapper input:focus {
            border-color: #006633;
        }

        .btn-submit {
            width: 100%;
            padding: 12px;
            background-color: #006633;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.3s;
            margin-top: 10px;
        }

        .btn-submit:hover {
            background-color: #004d26;
        }

        /* Divider */
        .divider {
            position: relative;
            text-align: center;
            margin: 25px 0;
        }

        .divider::before {
            content: "";
            position: absolute;
            top: 50%;
            left: 0;
            width: 100%;
            height: 1px;
            background-color: #eee;
        }

        .divider span {
            position: relative;
            background-color: white;
            padding: 0 10px;
            font-size: 0.8rem;
            color: #888;
        }

        /* Google Login Button */
        .btn-google {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 6px;
            background-color: white;
            color: #444;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.3s;
            text-decoration: none;
        }

        .btn-google:hover {
            background-color: #f9f9f9;
        }

        /* Footer Styling */
        footer {
            background-color: #fff;
            border-top: 1px solid #eee;
            padding: 20px;
            text-align: center;
            font-size: 0.8rem;
            color: #666;
        }

        footer p:first-child {
            font-weight: 600;
            color: #006633;
            margin-bottom: 4px;
        }
    </style>
</head>
<body>

    <!-- Header Section -->
    <header>
        <div class="header-container">
            <div class="brand-info">
                <img src="https://lh3.googleusercontent.com/d/1drM76LlU3sdqpwo-Urq7ZULoyORC0UMQ" alt="Logo YPP Nurul Muttaqin">
                <div class="brand-text">
                    <h1>YPP NURUL MUTTAQIN</h1>
                    <p>Sistem Informasi & Panel Pengurus</p>
                </div>
            </div>
            <div>
                <a href="index.html" class="btn-beranda">
                    <i class="fa-solid fa-house"></i> Beranda
                </a>
            </div>
        </div>
    </header>

    <!-- Main Content Section -->
    <main>
        <div class="login-card">
            <div class="card-header">
                <div class="icon-box">
                    <i class="fa-solid fa-user-shield"></i>
                </div>
                <h2>Panel Pengurus</h2>
                <p>Masuk dengan kredensial atau verifikasi akun Google</p>
            </div>

            <!-- Form Login -->
            <form action="#" method="POST">
                <div class="form-group">
                    <label for="username">Username / Email</label>
                    <div class="input-wrapper">
                        <i class="fa-solid fa-user"></i>
                        <input type="text" id="username" name="username" placeholder="Masukkan username" required>
                    </div>
                </div>

                <div class="form-group">
                    <label for="password">Kata Sandi</label>
                    <div class="input-wrapper">
                        <i class="fa-solid fa-lock"></i>
                        <input type="password" id="password" name="password" placeholder="Masukkan kata sandi" required>
                    </div>
                </div>

                <button type="submit" class="btn-submit">Masuk</button>
            </form>

            <!-- Divider -->
            <div class="divider">
                <span>Atau</span>
            </div>

            <!-- Google Login -->
            <button class="btn-google">
                <svg width="18" height="18" viewBox="0 0 24 24">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                </svg>
                Masuk dengan Google
            </button>
        </div>
    </main>

    <!-- Footer Section -->
    <footer>
        <p>YPP NURUL MUTTAQIN</p>
        <p>© 2026 Lembaga IT & Infokom YPP Nurul Muttaqin</p>
    </footer>

</body>
</html>
